+// ==== Request pacing (Pacer) ====
+
+// The effort of each request (Solver::effort): 0 the full search, 1 without the extra parent of the
+// neutral search and at most 2 neutral rounds, 2 one neutral round without the extra plans, the
+// alternates' ejection and the weighted plan, 3 also only 2 plans edited and 1 ejection round, 4 also
+// without the neutral search, kLightEffort the light plan (the first legal plan of the options). The
+// levels are ordered by the loss per ms saved, measured with every request at one level.
+// The clock is read once per request (after reading it); a cycle is the time between two reads
+// (planning, output and the round trip to the judge). full is the estimated cycle at effort 0: it
+// starts at the prior kPriorFull with the weight of kPriorWeight cycles, and every cycle at an
+// effort e < kLightEffort moves it towards its time / kEffortShare[e] by 1 / (cycles + weight), at
+// least kPaceAlpha (the mean while the cycles are few, then a moving average); a cycle above
+// kPaceClip x full counts as kPaceClip x full (a stall of the machine is not expected to repeat).
+// Before each request (from the first one on), effort e is allowed if
+//   pacing: now + kEffortShare[e] x (requests left) x full x discount <= kPaceEnd, the discount
+//     1 - kPaceMargin x kPaceCv / sqrt(cycles + weight) (at least 0.5) being the estimate's error, so
+//     that its noise does not make early requests lighter than needed (the bound tightens to kPaceEnd
+//     as the requests run out), and
+//   last resort: now + kEffortShare[e] x full + (requests left - 1) x the safe light cycle <= kHardEnd,
+//     the safe light cycle being the larger of kLightSafe (the prior light plan and 3 x the prior round
+//     trip) and kLightPlanShare x full + 3 x trip (the light plan at the measured speed and 3 x the
+//     measured round trip: trip estimates the cycle minus the planning, the output and the wait for
+//     the judge, like full from the prior kPriorTrip, a round trip above 20 x trip counting as 20 x
+//     trip), so that the light plan for the rest of the requests still ends by kHardEnd;
+// the least effort allowed is used, else the light plan. From kPaceEnd on, nothing is allowed.
+// The shares and the prior are measured locally with fixed designs, every request at one effort
+// (solutions/jflags-notes/PROGRESS.md), and the prior is scaled by kJudgeFactor for the judge.
+#ifndef PACE_END
+#define PACE_END 1.88
+#endif
+#ifndef PACE_HARD
+#define PACE_HARD 1.92
+#endif
+#ifndef PACE_ALPHA
+#define PACE_ALPHA (1.0 / 256)
+#endif
+#ifndef PACE_MARGIN
+#define PACE_MARGIN 1.0
+#endif
+constexpr double kPaceEnd = PACE_END, kHardEnd = PACE_HARD, kPaceAlpha = PACE_ALPHA, kPaceClip = 4.0;
+constexpr double kPaceMargin = PACE_MARGIN, kPaceCv = 0.71;  // kPaceCv: the variation of one cycle at effort 0
+// the prior (local scaled clock, fixed designs): planning at effort 0 490 us, the light plan 14 us and
+// the round trip 11 us per request
+constexpr double kJudgeFactor = 1.35, kPriorWeight = 8;
+constexpr double kPriorFull = (490e-6 + 11e-6) * kJudgeFactor, kPriorTrip = 11e-6 * kJudgeFactor;
+constexpr double kLightSafe = 14e-6 * kJudgeFactor + 3 * 11e-6, kLightPlanShare = 14.0 / 490;
+constexpr int kEfforts = 6, kLightEffort = kEfforts - 1;
+// the time of a request cycle at each effort over that at effort 0
+constexpr std::array<double, kEfforts> kEffortShare = {1.0, 0.960, 0.758, 0.659, 0.447, 0.049};
+struct Pacer {
+    double full = kPriorFull, last = -1;
+    double trip = kPriorTrip, last_plan = 0;  // the round trip estimate; the planning time of the last request
+    int trips = 0;
+    // statistics only: the longest cycle, and the cycles at effort 0 (sum, sum of squares, count; and
+    // their sum by eighths of the requests)
+    double max_cycle = 0, cycle0_sum = 0, cycle0_sq = 0;
+    std::array<double, 8> cycle0_part{};
+    std::array<int, 8> cycle0_part_n{};
+    int cycle0_n = 0, cycles = 0;
+    int samples = 0, last_effort = 0;
+    // the cycle that ended at now (the request read): its time at the effort it used
+    void record(double now) {
+        if (last >= 0) {
+            const double c = now - last;
+            const double rt = std::min(std::max(0.0, c - last_plan), 20 * trip);
+            trip += std::max(kPaceAlpha, 1.0 / (trips + kPriorWeight + 1)) * (rt - trip);
+            trips++;
+            max_cycle = std::max(max_cycle, c);
+            if (last_effort == 0) {
+                cycle0_sum += c, cycle0_sq += c * c, cycle0_n++;
+                cycle0_part[std::min(7, cycles / 128)] += c, cycle0_part_n[std::min(7, cycles / 128)]++;
+            }
+            cycles++;
+        }
+        if (last >= 0 && last_effort < kLightEffort) {
+            const double t = std::min((now - last) / kEffortShare[last_effort], kPaceClip * full);
+            full += std::max(kPaceAlpha, 1.0 / (samples + kPriorWeight + 1)) * (t - full);
+            samples++;
+        }
+        last = now;
+    }
+    int choose(int r, int R, double now) {
+        const int left = R - r;
+        const double weight = std::min(samples + kPriorWeight, 1 / kPaceAlpha);
+        const double cost = left * full * std::max(0.5, 1 - kPaceMargin * kPaceCv / std::sqrt(weight));
+        const double light_tail = (left - 1) * std::max(kLightSafe, kLightPlanShare * full + 3 * trip);
+        int e = kLightEffort;
+        for (int f = 0; f < kLightEffort; f++)
+            if (now + kEffortShare[f] * cost <= kPaceEnd && now + kEffortShare[f] * full + light_tail <= kHardEnd) {
+                e = f;
+                break;
+            }
+        last_effort = e;
+        return e;
+    }
+};
