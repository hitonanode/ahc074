+// ==== Common: locals left uninitialized under -ftrivial-auto-var-init (NOINIT) ====
+
+// The judge compiles with -ftrivial-auto-var-init=zero, which zero-fills every automatic variable
+// without an initializer at each entry. NOINIT marks hot scratch arrays that the code writes before it
+// reads them (buffers with a count, or explicitly filled ranges), so they keep their speed there.
+// Builds without that flag are unchanged.
+#if defined(__clang__)
+#define NOINIT [[clang::uninitialized]]
+#elif defined(__GNUC__) && __GNUC__ >= 12
+#define NOINIT __attribute__((uninitialized))
+#else
+#define NOINIT
+#endif
+// NOINIT_CLANG: the same on Clang only. GCC was measured slower with the window-assignment scratch
+// marked (its zero fill there costs nothing measurable and the code without it ran about 17 ms slower).
+#if defined(__clang__)
+#define NOINIT_CLANG [[clang::uninitialized]]
+#else
+#define NOINIT_CLANG
+#endif
