#ifdef LOCAL_BENCH
// Optional research artifacts, generated by the evaluated solver itself. Each
// candidate uses DesignStore's format and is replayed only through pahcer_run.py.
void lns_dump_design(const DesignState& saved,const std::vector<u64>& originalA,int id,double value,bool failed=false) {
    const char* root=std::getenv("LNS_DUMP_DIR");if(!root||!*root)return;
    if(const char* select=std::getenv("LNS_DUMP_IDS")) {
        std::string text(select);std::replace(text.begin(),text.end(),',',' ');std::istringstream in(text);
        bool found=false;int x;while(in>>x)found|=x==id;if(!found)return;
    }
    auto state=saved;improve_initial_columns(state);
    u64 hash=0xcbf29ce484222325ULL;
    for(u64 a:originalA)for(int b=0;b<8;++b)hash=(hash^(a>>(8*b)&255))*0x100000001b3ULL;
    char name[80];std::snprintf(name,sizeof name,"/candidate-%03d/design/%016llx.txt",id,(unsigned long long)hash);
    std::string path=std::string(root)+name;
    std::filesystem::create_directories(std::filesystem::path(path).parent_path());
    std::ofstream out(path);out.precision(17);
    auto list=[&](const char* key,const auto& values){out<<key<<' '<<values.size();for(const auto& v:values)out<<' '<<v;out<<'\n';};
    out<<"design_state 1\nemergency 0\nend_ticks 0\nend_sec 0\nhelpers_ready 1\nM "<<state.M<<"\nG "<<state.G<<"\nH "<<state.H<<'\n';
    list("permutation",state.permutation);list("A",state.A);
    std::vector<int> edge;for(auto [a,b]:state.edge){edge.push_back(a);edge.push_back(b);}list("edge",edge);list("polarity",state.polarity);
    std::vector<u64> papers;for(auto p:state.papers){papers.push_back(p.opaque);papers.push_back(p.black);}list("papers",papers);
    list("columns",state.columns);list("ded",state.ded);list("handle",state.handle);
    std::ostringstream msg;msg.precision(17);msg<<"lns_export_id = "<<id<<"\nlns_export_failure = "<<failed<<"\nlns_export_v = "<<value<<'\n';
    const auto text=msg.str();out<<"stderr "<<text.size()<<'\n'<<text;
    if(!out){std::cerr<<"lns_dump_error: "<<path<<'\n';std::exit(1);}
}
#endif
