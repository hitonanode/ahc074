+// DP for staircase capacities: weighted retrieval ranks plus forced handle holes.
+void profile_initialize(Design& d,double hole_weight) {
+    const int U=d.U,NP=d.need,H=d.H,S=(U+1)*(NP+1);
+    std::vector<double> dp(S,1e20),ndp(S);
+    std::vector<uint16_t> take((H+1)*S,65535);
+    auto idx=[&](int n,int p){return n*(NP+1)+p;};dp[0]=0;
+    for(int c=0;c<H;c++) {
+        std::fill(ndp.begin(),ndp.end(),1e20);
+        for(int n=2*c;n<=U-2*(H-c);n++)for(int pa=0;pa<=std::min(n,NP);pa++)if(dp[idx(n,pa)]<1e19)
+            for(int nn=2;nn<=std::min(17,U-n-2*(H-c-1));nn++)for(int pp=0;pp<=std::min(nn,NP-pa);pp++) {
+                double cost=.5*(nn*(nn-1)+pp*(pp-1))+hole_weight*(nn+pp)*(H-1-c);
+                int j=idx(n+nn,pa+pp);
+                if(dp[idx(n,pa)]+cost<ndp[j]){ndp[j]=dp[idx(n,pa)]+cost;take[(c+1)*S+j]=(nn<<8)|pp;}
+            }
+        dp.swap(ndp);
+    }
+    std::vector<int> capacity(H),pairs(H);int n=U,pa=NP;
+    for(int c=H;c>0;c--){int t=take[c*S+idx(n,pa)];assert(t!=65535);capacity[c-1]=t>>8;pairs[c-1]=t&255;n-=t>>8;pa-=t&255;}
+    struct Slot{int c,rank,color;};std::vector<Slot> slots;
+    for(int c=0;c<H;c++)for(int rank=0;rank<capacity[c];rank++)slots.push_back({c,rank,rank<2?rank:-1});
+    std::vector<std::vector<double>> cost(U,std::vector<double>(U,1e9));
+    for(int x=0;x<U;x++)for(int j=0;j<U;j++) {
+        auto u=d.unit[x];auto s=slots[j];
+        if(!d.valid(u,s.c)||(s.color>=0&&d.color(u,s.c)!=s.color))continue;
+        u64 dif=u.b<0?0:d.hb[u.a]^d.hb[u.b];
+        cost[x][j]=d.weight(u)*(s.rank+hole_weight*(H-1-s.c))+2*hole_weight*Design::pc(dif&low_bits(s.c+1));
+    }
+    auto ass=hungarian(cost);
+    for(int x=0;x<U;x++)if(cost[x][ass[x]]>=1e8)return; // keep feasible initializer if the slot assignment fails
+    for(int x=0;x<U;x++)d.unit[x].c=slots[ass[x]].c;
+    d.rebuild();
+}
